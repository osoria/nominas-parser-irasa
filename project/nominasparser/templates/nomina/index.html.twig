{% extends 'base.html.twig' %}

{% block title %}Parseador de nóminas para Irasa{% endblock %}

{% block body %}
    <div class="container-contact100" style="background-image: url({{ asset('images/bg-01.jpg') }});">
        <div class="wrap-contact100">
            {# TODO - Meter la clase correspondiente en formulario e input type #}

            <span class="contact100-form-title">
                Parseador de nóminas de Irasa
            </span>

            {{ form_start(form, {'attr': {'class': 'contact100-form'}}) }}

                <div class="wrap-input100 rs1-wrap-input100 validate-input" data-validate="El fichero es obligatorio">
                    <span class="label-input100">Introduce el fichero de nóminas *</span>
                    {{ form_row(form.pdf, {'attr': {'class': 'input100'}}) }}
                </div>

                <div class="wrap-input100 rs1-wrap-input100 validate-input">
                    <span class="label-input100">Modo de envío</span>
                    {{ form_row(form.mode) }}

                    <div id="custom_email_div" class="wrap-input100 rs1-wrap-input100" style="margin-top: 10px; display: none;">
                        <span class="label-input100">Email destino</span>
                        {{ form_row(form.custom_email, {'attr': {'class': 'input100 input100-email-custom'}}) }}
                    </div>

                    <div class="employes">
                        {% for empleado in empleados %}
                            <input type="checkbox" name="empleado[]" value="{{ empleado.id }}" />
                            <span class="label-input100">{{ empleado.apellidos }}, {{ empleado.nombre }}</span>
                            <br/>
                        {% endfor %}
                    </div>
                </div>

                <div class="container-contact100-form-btn">
                    <div class="wrap-contact100-form-btn">
                        <div class="contact100-form-bgbtn"></div>
                        <button class="contact100-form-btn">
                            Submit
                        </button>
                    </div>
                </div>

            {{ form_end(form) }}

            <div class="input100 resume">
                {{ log | raw }}
            </div>

        </div>

    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            var modeSelect = document.getElementById('nomina_pdf_mode');
            var customEmailDiv = document.getElementById('custom_email_div');

            function toggleCustomEmail() {
                if (modeSelect && customEmailDiv) {
                    if (modeSelect.value === 'custom') {
                        customEmailDiv.style.display = 'block';
                    } else {
                        customEmailDiv.style.display = 'none';
                    }
                }
            }

            if (modeSelect) {
                modeSelect.addEventListener('change', toggleCustomEmail);
                toggleCustomEmail();
            }
        });
    </script>

{% endblock %}